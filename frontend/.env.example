# URL base del backend Spring Boot (sin barra final)
VITE_API_URL=https://tu-backend.onrender.com

# Clave publica de Stripe en modo prueba (empieza por pk_test_).
# La clave secreta debe vivir solo en el backend (STRIPE_SECRET_KEY).
VITE_STRIPE_PUBLISHABLE_KEY=

# Credenciales opcionales para un boton de acceso de demostracion.
# Dejalas vacias en el repositorio; cada entorno define sus propios valores.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
