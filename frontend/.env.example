# URL base del backend Spring Boot (sin barra final)
VITE_API_URL=http://localhost:8080

# Clave pública de Stripe en modo prueba (empieza por pk_test_).
# La clave secreta debe vivir solo en el backend (STRIPE_SECRET_KEY).
VITE_STRIPE_PUBLISHABLE_KEY=

# Credenciales opcionales para un botón de acceso de demostración.
# Déjalas vacías en el repositorio; cada entorno define sus propios valores.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
